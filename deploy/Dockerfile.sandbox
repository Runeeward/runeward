# Default sandbox image: headless Chromium + the runeward-browser CDP driver,
# so the governed browser tool works out of the box, and runeward-supervisor,
# the in-sandbox entrypoint that confines the agent (Landlock, seccomp, a
# dropped identity) for Charters with [filesystem] or [process]. Any image
# works as a sandbox; profiles that don't use the browser tool or the
# supervisor can use any base.

# runeward-supervisor and runeward-browser from the Rust workspace. Built
# natively for the target platform (no --platform=$BUILDPLATFORM: the
# Alpine/musl toolchain links static binaries for the runtime stage below
# without a cross linker).
FROM rust:1.99-alpine@sha256:557a94c82b485a14b569120e00867267108c734efe33f10cc31ca0cd5dd1eca9 AS rust-build
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p runeward-supervisor -p runeward-browser \
        --bin runeward-supervisor --bin runeward-browser \
    && install -D -m 0755 target/release/runeward-supervisor /out/runeward-supervisor \
    && install -D -m 0755 target/release/runeward-browser /out/runeward-browser

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk upgrade --no-cache \
    && apk add --no-cache chromium ca-certificates curl python3 nodejs
COPY --from=rust-build /out/runeward-browser /usr/local/bin/runeward-browser
# The control plane starts supervised sandboxes with this as PID 1.
COPY --from=rust-build /out/runeward-supervisor /usr/local/bin/runeward-supervisor

RUN adduser -D -u 1000 sandbox \
    && mkdir -p /workspace \
    && chown -R sandbox:sandbox /workspace
USER sandbox
ENV HOME=/home/sandbox
WORKDIR /workspace
CMD ["sleep", "infinity"]
