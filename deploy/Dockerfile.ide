# Optional Citadel images for the experimental browser IDE. The `ide` target
# contains code-server only; `ide-agents` also installs Codex and Claude Code.
# Keep the default sandbox/agent images lean and build the target you need:
#
#   docker build --target ide -f deploy/Dockerfile.ide -t runeward-ide:latest .
#   docker build --target ide-agents -f deploy/Dockerfile.ide -t runeward-ide-agents:latest .
#
# Charter: examples/ide-demo.toml  (+ RUNEWARD_ENABLE_EXPERIMENTAL_IDE=1 on serve)
#
# PID 1 stays `sleep infinity` so the control plane can Exec-start code-server
# after create (same pattern as other long-lived helpers inside the environment).

# code-server bundles JavaScript packages with published HIGH/CRITICAL fixes.
# Build the replacements away from the final image so npm and its dependency
# tree do not enlarge the runtime attack surface. Each entry is
# <package>@<fixed version>:<directory under /usr/lib/code-server>.
ARG CODE_SERVER_PATCHES="\
undici@7.29.1:lib/vscode/node_modules \
tar@7.5.21:lib/vscode/node_modules \
shell-quote@1.11.0:lib/vscode/node_modules \
ip-address@10.3.1:lib/vscode/node_modules \
ip-address@10.3.1:node_modules \
js-yaml@4.3.2:node_modules \
proxy-addr@2.0.8:node_modules \
compression@1.8.2:node_modules \
basic-ftp@6.2.1:node_modules"

FROM codercom/code-server:4.138.0-noble@sha256:202d1c80b301d8eb5779637bf0aaa17d41540b73cbdf0a098ff55e0d4836da75 AS code-server-security-patches

ARG CODE_SERVER_PATCHES
USER root
RUN [ -n "${CODE_SERVER_PATCHES}" ] \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends npm \
    && for patch in ${CODE_SERVER_PATCHES}; do \
         pkg="${patch%%:*}"; \
         npm install --prefix "/tmp/security-patches/${pkg}" --omit=dev --ignore-scripts --no-package-lock "${pkg}" || exit 1; \
       done

FROM codercom/code-server:4.138.0-noble@sha256:202d1c80b301d8eb5779637bf0aaa17d41540b73cbdf0a098ff55e0d4836da75 AS ide

ARG CODE_SERVER_PATCHES
USER root
COPY --from=code-server-security-patches /tmp/security-patches /tmp/security-patches
# Ubuntu security updates for the base image (OpenSSL), then the patched
# JavaScript packages, each checked for the exact version that replaced it.
# Dependencies a fix adds are copied in without replacing existing modules.
RUN [ -n "${CODE_SERVER_PATCHES}" ] \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --only-upgrade --no-install-recommends openssl libssl3t64 \
    && rm -rf /var/lib/apt/lists/* \
    && for patch in ${CODE_SERVER_PATCHES}; do \
         pkg="${patch%%:*}"; dir="/usr/lib/code-server/${patch#*:}"; \
         name="${pkg%@*}"; version="${pkg##*@}"; \
         rm -rf "${dir}/${name}" \
         && cp -a "/tmp/security-patches/${pkg}/node_modules/${name}" "${dir}/${name}" \
         && grep -Eq "\"version\"[[:space:]]*:[[:space:]]*\"${version}\"" "${dir}/${name}/package.json" \
         && cp -an "/tmp/security-patches/${pkg}/node_modules/." "${dir}/" \
         || { echo "failed to patch ${pkg} into ${dir}" >&2; exit 1; }; \
       done \
    && rm -rf /tmp/security-patches /usr/local/bin/fixuid /etc/fixuid \
    && code-server --version \
    && mkdir -p /workspace \
    && chown -R coder:coder /workspace

USER coder
ENV HOME=/home/coder
WORKDIR /workspace
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["code-server", "--version"]
ENTRYPOINT []
CMD ["sleep", "infinity"]

FROM ide AS agent-cli-builder

USER root
ARG CODEX_VERSION=0.142.5
ARG CLAUDE_CODE_VERSION=2.1.201
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends npm \
    && ln -sf /usr/lib/code-server/lib/node /usr/local/bin/node \
    && node --version | grep -Eq '^v2[4-9]\.' \
    && npm install -g --prefix /opt/agent-cli \
        "@openai/codex@${CODEX_VERSION}" \
        "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"

FROM ide AS ide-agents

USER root
COPY --from=agent-cli-builder /opt/agent-cli /opt/agent-cli
RUN ln -sf /usr/lib/code-server/lib/node /usr/local/bin/node \
    && node --version | grep -Eq '^v2[4-9]\.' \
    && /opt/agent-cli/bin/codex --version \
    && /opt/agent-cli/bin/claude --version

USER coder
ENV PATH="/opt/agent-cli/bin:/home/coder/.local/bin:/home/coder/.cursor/bin:${PATH}"

# Cursor CLI is opt-in and its installer must be pinned by digest.
ARG INSTALL_CURSOR=false
ARG CURSOR_INSTALLER_SHA256=""
RUN if [ "$INSTALL_CURSOR" = "true" ]; then \
      curl -fsS https://cursor.com/install -o /tmp/cursor-install.sh \
      && if [ -z "$CURSOR_INSTALLER_SHA256" ]; then \
           echo "CURSOR_INSTALLER_SHA256 is required when INSTALL_CURSOR=true" >&2 ; \
           exit 1 ; \
         fi \
      && echo "${CURSOR_INSTALLER_SHA256}  /tmp/cursor-install.sh" | sha256sum -c - \
      && bash /tmp/cursor-install.sh \
      && rm -f /tmp/cursor-install.sh ; \
    fi
