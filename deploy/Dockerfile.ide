# Optional Citadel images for the experimental browser IDE. The `ide` target
# contains code-server only; `ide-agents` also installs Codex and Claude Code.
# Keep the default sandbox/agent images lean and build the target you need:
#
#   docker build --target ide -f deploy/Dockerfile.ide -t runeward-ide:latest .
#   docker build --target ide-agents -f deploy/Dockerfile.ide -t runeward-ide-agents:latest .
#
# Charter: examples/ide-demo.toml  (+ RUNEWARD_ENABLE_EXPERIMENTAL_IDE=1 on serve)
#
# PID 1 stays `sleep infinity` so the control plane can Exec-start code-server
# after create (same pattern as other long-lived in-cell helpers).
FROM codercom/code-server:4.138.0-noble@sha256:202d1c80b301d8eb5779637bf0aaa17d41540b73cbdf0a098ff55e0d4836da75 AS code-server-security-patches

# code-server 4.135.0 bundles five JavaScript packages with published
# HIGH/CRITICAL fixes. Build the replacements away from the final image so npm
# and its dependency tree do not enlarge the runtime attack surface.
USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends npm \
    && npm install --prefix /tmp/security-patches --omit=dev --ignore-scripts --no-package-lock \
        undici@7.29.0 tar@7.5.21 shell-quote@1.9.0 js-yaml@4.3.2 ip-address@10.3.1

FROM codercom/code-server:4.138.0-noble@sha256:202d1c80b301d8eb5779637bf0aaa17d41540b73cbdf0a098ff55e0d4836da75 AS ide

USER root
COPY --from=code-server-security-patches /tmp/security-patches/node_modules /tmp/security-patches/node_modules
RUN rm -rf \
        /usr/lib/code-server/lib/vscode/node_modules/undici \
        /usr/lib/code-server/lib/vscode/node_modules/tar \
        /usr/lib/code-server/lib/vscode/node_modules/shell-quote \
        /usr/lib/code-server/lib/vscode/node_modules/ip-address \
        /usr/lib/code-server/node_modules/js-yaml \
        /usr/lib/code-server/node_modules/ip-address \
    && cp -a /tmp/security-patches/node_modules/undici /usr/lib/code-server/lib/vscode/node_modules/undici \
    && cp -a /tmp/security-patches/node_modules/tar /usr/lib/code-server/lib/vscode/node_modules/tar \
    && cp -a /tmp/security-patches/node_modules/shell-quote /usr/lib/code-server/lib/vscode/node_modules/shell-quote \
    && cp -a /tmp/security-patches/node_modules/ip-address /usr/lib/code-server/lib/vscode/node_modules/ip-address \
    && cp -a /tmp/security-patches/node_modules/js-yaml /usr/lib/code-server/node_modules/js-yaml \
    && cp -a /tmp/security-patches/node_modules/ip-address /usr/lib/code-server/node_modules/ip-address \
    && grep -Eq '"version"[[:space:]]*:[[:space:]]*"7\.29\.0"' /usr/lib/code-server/lib/vscode/node_modules/undici/package.json \
    && grep -Eq '"version"[[:space:]]*:[[:space:]]*"7\.5\.21"' /usr/lib/code-server/lib/vscode/node_modules/tar/package.json \
    && grep -Eq '"version"[[:space:]]*:[[:space:]]*"1\.9\.0"' /usr/lib/code-server/lib/vscode/node_modules/shell-quote/package.json \
    && grep -Eq '"version"[[:space:]]*:[[:space:]]*"4\.3\.2"' /usr/lib/code-server/node_modules/js-yaml/package.json \
    && grep -Eq '"version"[[:space:]]*:[[:space:]]*"10\.3\.1"' /usr/lib/code-server/lib/vscode/node_modules/ip-address/package.json \
    && grep -Eq '"version"[[:space:]]*:[[:space:]]*"10\.3\.1"' /usr/lib/code-server/node_modules/ip-address/package.json \
    && rm -rf /tmp/security-patches /usr/local/bin/fixuid /etc/fixuid \
    && mkdir -p /workspace \
    && chown -R coder:coder /workspace

USER coder
ENV HOME=/home/coder
WORKDIR /workspace
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["code-server", "--version"]
ENTRYPOINT []
CMD ["sleep", "infinity"]

FROM ide AS agent-cli-builder

USER root
ARG CODEX_VERSION=0.142.5
ARG CLAUDE_CODE_VERSION=2.1.201
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends npm \
    && ln -sf /usr/lib/code-server/lib/node /usr/local/bin/node \
    && node --version | grep -Eq '^v2[4-9]\.' \
    && npm install -g --prefix /opt/agent-cli \
        "@openai/codex@${CODEX_VERSION}" \
        "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"

FROM ide AS ide-agents

USER root
COPY --from=agent-cli-builder /opt/agent-cli /opt/agent-cli
RUN ln -sf /usr/lib/code-server/lib/node /usr/local/bin/node \
    && node --version | grep -Eq '^v2[4-9]\.' \
    && /opt/agent-cli/bin/codex --version \
    && /opt/agent-cli/bin/claude --version

USER coder
ENV PATH="/opt/agent-cli/bin:/home/coder/.local/bin:/home/coder/.cursor/bin:${PATH}"

# Cursor CLI is opt-in and its installer must be pinned by digest.
ARG INSTALL_CURSOR=false
ARG CURSOR_INSTALLER_SHA256=""
RUN if [ "$INSTALL_CURSOR" = "true" ]; then \
      curl -fsS https://cursor.com/install -o /tmp/cursor-install.sh \
      && if [ -z "$CURSOR_INSTALLER_SHA256" ]; then \
           echo "CURSOR_INSTALLER_SHA256 is required when INSTALL_CURSOR=true" >&2 ; \
           exit 1 ; \
         fi \
      && echo "${CURSOR_INSTALLER_SHA256}  /tmp/cursor-install.sh" | sha256sum -c - \
      && bash /tmp/cursor-install.sh \
      && rm -f /tmp/cursor-install.sh ; \
    fi
